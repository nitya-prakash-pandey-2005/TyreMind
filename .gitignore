# ---- secrets ----
.env
.env.local
*.key
credentials.json

# ---- python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- data (large / regenerable) ----
data/raw/
data/interim/
data/processed/
data/external/
cache/
fastf1_cache/
*.parquet
# Demo cache IS committed: the offline demo must work on a fresh clone.
!data/demo/*.parquet
!data/demo/*.json

# ---- node ----
node_modules/
# apps/web/dist/ is deliberately NOT ignored. The built dashboard is committed so
# that a clone runs with Python alone -- no Node, no npm install, no build step.
# Rebuild and re-commit it after any frontend change:  npm --prefix apps/web run build
apps/web/.vite/
*.log

# ---- os / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
