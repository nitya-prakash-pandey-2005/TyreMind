# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Optional: enables LLM narration of model output.
# Without it, TyreMind uses deterministic templates (fully offline, no hallucination).
GEMINI_API_KEY=

# Optional: alternative narration provider
ANTHROPIC_API_KEY=

# FastF1 on-disk cache (defaults to ./cache/fastf1 if unset)
TYREMIND_FASTF1_CACHE=

# API server
TYREMIND_API_HOST=127.0.0.1
TYREMIND_API_PORT=8000
